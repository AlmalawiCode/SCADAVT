{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scadavt/core/config.schema.json",
  "title": "SCADAVT experiment configuration",
  "description": "Domain-neutral SCADA network experiment. The single shared model used by the Python API/CLI and the GUI designer. Structural contract only; scadavt.core.coregen.validate is the authoritative semantic validator.",
  "type": "object",
  "required": ["devices"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "name": {"type": "string"},
    "netmask": {"type": "integer", "minimum": 1, "maximum": 32},
    "control": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "placement": {"type": "string", "enum": ["mtu", "plc", "distributed"]}
      }
    },
    "mtu": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string"},
        "ip": {"type": "string"},
        "model": {"type": "string"}
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "ip": {"type": "string"},
          "kind": {"type": "string"},
          "model": {"type": "string"},
          "protocol": {"type": "string"},
          "backchannel": {"type": "string"},
          "seed": {"type": "number"},
          "registers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "area"],
              "additionalProperties": true,
              "properties": {
                "id": {"type": "string"},
                "area": {"type": "string", "enum": ["coil", "discrete_input", "holding_register", "input_register"]},
                "address": {"type": "integer", "minimum": 0},
                "data_type": {"type": "string", "enum": ["bool", "uint16", "int16", "uint32", "int32", "float32"]},
                "scale": {"type": "number"},
                "offset": {"type": "number"},
                "word_order": {"type": "string", "enum": ["big", "little"]},
                "owner": {"type": "string", "enum": ["mtu", "plc", "process", "any"]},
                "initial": {}
              }
            }
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "additionalProperties": true,
              "properties": {
                "id": {"type": "string"},
                "role": {"type": "string", "enum": ["measurement", "command"]},
                "is_bool": {"type": "boolean"}
              }
            }
          },
          "io_modules": {
            "type": "array",
            "description": "I/O modules (DI/DO/AI/AO); each channel becomes a register (scadavt.core.fieldio).",
            "items": {
              "type": "object",
              "required": ["type", "channels"],
              "additionalProperties": true,
              "properties": {
                "type": {"type": "string", "enum": ["DI", "DO", "AI", "AO"]},
                "channels": {"type": "integer", "minimum": 1, "maximum": 16},
                "slot": {"type": "integer"},
                "data_type": {"type": "string"},
                "scale": {"type": "number"}, "offset": {"type": "number"}
              }
            }
          }
        }
      }
    },
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["switch", "hub"]}
        }
      }
    },
    "routers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "model": {"type": "string"},
          "ip": {"type": "string"}
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "additionalProperties": true,
        "properties": {
          "a": {"type": "string"},
          "b": {"type": "string"},
          "a_ip": {"type": "string"},
          "b_ip": {"type": "string"},
          "delay_ms": {"type": "number", "minimum": 0},
          "loss": {"type": "number", "minimum": 0, "maximum": 100},
          "bw": {"type": "integer", "minimum": 0}
        }
      }
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["point", "device"],
        "additionalProperties": true,
        "properties": {
          "point": {"type": "string"},
          "device": {"type": "string"},
          "role": {"type": "string", "enum": ["measurement", "command"]},
          "element": {"type": "string"}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {"type": "object"}
    },
    "logic": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "if": {"type": "array", "items": {
            "type": "object", "required": ["device", "register"],
            "properties": {
              "device": {"type": "string"}, "register": {"type": "string"},
              "op": {"type": "string", "enum": ["below", "above", "at_most", "at_least", "equal", "not_equal"]},
              "value": {"type": "number"}}}},
          "then": {"type": "array", "items": {
            "type": "object", "required": ["device", "register"],
            "properties": {
              "device": {"type": "string"}, "register": {"type": "string"},
              "set": {"type": "number"}, "value": {"type": "number"}}}}
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["simulated", "hardware", "simulator"]},
          "authorized": {"type": "boolean"}
        }
      }
    },
    "io_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adapter", "device", "register"],
        "additionalProperties": true,
        "properties": {
          "adapter": {"type": "string"},
          "external": {"type": "object"},
          "device": {"type": "string"},
          "register": {"type": "string"},
          "direction": {"type": "string", "enum": ["in", "out"]},
          "scale": {"type": "number"}, "offset": {"type": "number"},
          "max_age": {"type": "number"},
          "quality": {"type": "string", "enum": ["hold_last", "default", "fault"]},
          "default": {"type": "number"},
          "owner": {"type": "string", "enum": ["mtu", "plc", "process", "any"]},
          "limits": {"type": "object"}
        }
      }
    },
    "sensors": {
      "type": "array",
      "description": "Emulated sensors wired to PLC I/O channels (scadavt.core.fieldio).",
      "items": {
        "type": "object",
        "required": ["id", "type", "device", "channel"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"}, "type": {"type": "string"},
          "device": {"type": "string"}, "channel": {"type": "string"},
          "unit": {"type": "string"}, "wave": {"type": "string"},
          "min": {"type": "number"}, "max": {"type": "number"}, "value": {"type": "number"},
          "period": {"type": "number"}, "duty": {"type": "number"}
        }
      }
    },
    "actuators": {
      "type": "array",
      "description": "Emulated actuators wired to PLC I/O channels (scadavt.core.fieldio).",
      "items": {
        "type": "object",
        "required": ["id", "type", "device", "channel"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"}, "type": {"type": "string"},
          "device": {"type": "string"}, "channel": {"type": "string"},
          "unit": {"type": "string"}, "wave": {"type": "string"},
          "min": {"type": "number"}, "max": {"type": "number"}, "value": {"type": "number"},
          "period": {"type": "number"}, "duty": {"type": "number"}
        }
      }
    },
    "external_apps": {
      "type": "array",
      "items": {"type": "object"}
    }
  }
}
